# Vorlage fuer die .env im Projekt-Root.
# Kopieren mit:  cp .env.example .env   und dann die Werte eintragen.
# Die echte .env wird von .gitignore ausgeschlossen und gehoert nicht ins Repo.

DB_HOST=localhost
DB_PORT=5432
DB_NAME=trainingstracker
DB_USER=postgres
DB_PASSWORD=123456

# Origins, die per CORS zugreifen duerfen (spaeter die PWA), als JSON-Liste:
# BACKEND_CORS_ORIGINS=["http://localhost:5173"]
