#
#   dev  (npm run dev)   -> defaults to http://127.0.0.1:8000
#   prod (npm run build) -> defaults to the app's own origin, because the
#                           backend serves the built frontend itself
#
# VITE_API_BASE_URL=http://127.0.0.1:8000
